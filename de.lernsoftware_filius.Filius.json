{
    "app-id": "de.lernsoftware_filius.Filius",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk21"
    ],
    "command": "de.lernsoftware_filius.Filius",
    "rename-icon": "filius",
    "finish-args": [
        "--env=PATH=/app/jre/bin:/usr/bin:/app/bin",
        "--share=network",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=host"
    ],
    "modules": [
        {
            "name": "openjdk",
            "buildsystem": "simple",
            "build-commands": [
                "/usr/lib/sdk/openjdk21/install.sh"
            ]
        },
        {
            "name": "filius",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/filius",
                "cp -r * /app/filius",
                "chmod +x /app/filius/filius.sh"
            ],
            "post-install": [
                "install -Dm755 filius /app/bin/de.lernsoftware_filius.Filius",
                "install -Dm644 de.lernsoftware_filius.Filius.desktop -t /app/share/applications/",
                "install -Dm644 de.lernsoftware_filius.Filius.appdata.xml -t /app/share/metainfo/",
                "install -Dm644 filius.png -t /app/share/icons/hicolor/128x128/apps/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.lernsoftware-filius.de/downloads/Setup/filius-2.13.0.zip",
                    "sha256": "396db29ae7bc36688e0613e9361a51b5104942bfe3be22453acf508d7691b8d2",
                    "strip-components": 0
                },
                {
                    "type": "file",
                    "path": "filius"
                },
                {
                    "type": "file",
                    "path": "de.lernsoftware_filius.Filius.desktop"
                },
                {
                    "type": "file",
                    "path": "de.lernsoftware_filius.Filius.appdata.xml"
                },
                {
                    "type": "file",
                    "path": "img/filius.png"
                }
            ]
        }
    ]
}
